{
  "expo": {
    "name": "T1Together",
    "slug": "t1together",
    "scheme": "t1together",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.t1together.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "T1Together uses an approximate version of your location to match you with nearby community help. Your exact location is not shown to other members.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.t1together.app"
    },
    "owner": "t1together",
    "extra": {
      "eas": {
        "projectId": "45c7f243-9631-4d13-bffd-aee408dca705"
      }
    }
  }
}